# 代码生成器生成的文件（可选，建议不提交）
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

